      \uBA39\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 92,\n      \"type\": \"Pause\",\n     
      \"duration\": 0.6\n    },\n    {\n      \"id\": 93,\n      \"type\": \"Dialogue\",\n     
      \"duration\": 1.8,\n      \"text\": \"\\\"\u2026\uC624\uBE60.\\\"\",\n     
