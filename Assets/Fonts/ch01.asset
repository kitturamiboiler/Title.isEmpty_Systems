      0.9\n    },\n    {\n      \"id\": 83,\n      \"type\": \"FadeIn\",\n      \"duration\":
      0.9\n    },\n    {\n      \"id\": 84,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.5,\n      \"text\": \"\uC6B0\uC0B0 \uC544\uB798. \uBC18\uC529
      \uBE44\uB97C \uB9DE\uC73C\uBA70.\"\n    },\n    {\n      \"id\": 85,\n     
      \"type\": \"Narration\",\n      \"duration\": 3.5,\n      \"text\": \"\uC544\uBB34
      \uB9D0 \uC5C6\uC5C8\uB2E4. \uADF8\uB0E5 \uAC78\uC5C8\uB2E4.\\n\uCC98\uC74C\uC73C\uB85C
      \uC5B4\uC0C9\uD558\uC9C0 \uC54A\uC740 \uCE68\uBB35\uC774\uC5C8\uB2E4.\"\n   
