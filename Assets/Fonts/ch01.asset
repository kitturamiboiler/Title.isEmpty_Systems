      0.9\n    },\n    {\n      \"id\": 90,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.0,\n      \"text\": \"\uB2E4\uC74C\uB0A0\uC774\uC5C8\uB2E4.\"\n   
