    characterSetSelectionMode: 8
    characterSequence: "{\n  \"storyKey\": \"Chapter1_Opening\",\n  \"lines\": [\n   
      {\n      \"id\": 1,\n      \"type\": \"FadeIn\",\n      \"duration\": 1.5\n   
      },\n    {\n      \"id\": 2,\n      \"type\": \"Narration\",\n      \"duration\":
      3.2,\n      \"text\": \"\uBE44\uAC00 \uC624\uB294 \uB0A0\uC774\uBA74 \uD604\uC740\\n\uD56D\uC0C1
      \uADF8 \uACE8\uBAA9 \uC0DD\uAC01\uC744 \uD588\uB2E4.\"\n    },\n    {\n     
      \"id\": 3,\n      \"type\": \"Narration\",\n      \"duration\": 3.5,\n     
      \"text\": \"\uB113\uC9C0\uB3C4 \uC881\uC9C0\uB3C4 \uC54A\uC740 \uACE8\uBAA9.
      \uB0A1\uC740 \uB2F4\uBCBC\uB77D.\\n\uADF8 \uB05D\uC5D0 \uC11C \uC788\uB358
      \uC544\uC774.\"\n    },\n    {\n      \"id\": 4,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.8,\n      \"text\": \"\uC9C0\uAE08\uC73C\uB85C\uBD80\uD130
      9\uB144 \uC804\uC774\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 5,\n     
      \"type\": \"Pause\",\n      \"duration\": 1.2\n    },\n    {\n      \"id\":
      6,\n      \"type\": \"FadeOut\",\n      \"duration\": 0.9\n    },\n    {\n     
      \"id\": 7,\n      \"type\": \"FadeIn\",\n      \"duration\": 0.9\n    },\n   
      {\n      \"id\": 8,\n      \"type\": \"Narration\",\n      \"duration\": 2.0,\n     
      \"text\": \"\uD559\uAD50 \uC55E\uC740 \uC18C\uB780\uC2A4\uB7EC\uC6E0\uB2E4.\"\n   
      },\n    {\n      \"id\": 9,\n      \"type\": \"Narration\",\n      \"duration\":
      4.2,\n      \"text\": \"\uC218\uC5C5\uC774 \uB05D\uB09C \uC9C1\uD6C4\uBD80\uD130
      \uD558\uB298\uC774 \uBB34\uB108\uC9C8 \uAC83\uCC98\uB7FC \uBE44\uAC00 \uC3DF\uC544\uC84C\uB2E4.\\n\uC544\uC774\uB4E4\uC774
      \uCC98\uB9C8 \uC544\uB798\uB85C \uD53C\uD588\uB2E4.\\n\uC774\uB984\uC744 \uBD80\uB974\uB294
      \uC18C\uB9AC, \uBE57\uC18C\uB9AC\uAC00 \uB4A4\uC11E\uC600\uB2E4.\"\n    },\n   
      {\n      \"id\": 10,\n      \"type\": \"Pause\",\n      \"duration\": 0.6\n   
      },\n    {\n      \"id\": 11,\n      \"type\": \"Narration\",\n      \"duration\":
      2.5,\n      \"text\": \"\uC5F0\uC11C\uB294 \uCC98\uB9C8 \uB05D\uC5D0 \uD63C\uC790
      \uC11C \uC788\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 12,\n      \"type\":
      \"Narration\",\n      \"duration\": 3.5,\n      \"text\": \"\uAE30\uB2E4\uB9AC\uB294
      \uAC8C \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB0E5 \uC11C \uC788\uB294 \uAC70\uC600\uB2E4.\\n\uC62C
      \uC0AC\uB78C\uC774 \uC5C6\uB2E4\uB294 \uAC78 \uC54C\uACE0 \uC788\uC5C8\uC73C\uB2C8\uAE4C.\"\n   
      },\n    {\n      \"id\": 13,\n      \"type\": \"Narration\",\n      \"duration\":
      3.8,\n      \"text\": \"\uC544\uBB34\uAC83\uB3C4 \uAE30\uB300\uD558\uC9C0 \uC54A\uB294
      \uC0AC\uB78C\uC758 \uB208\uC774\uC5C8\uB2E4.\\n\uC5F4 \uC0B4\uC9DC\uB9AC \uC544\uC774\uC758
      \uB208\uC774\uB77C\uACE0 \uD558\uAE30\uC5D4 \uB108\uBB34 \uC870\uC6A9\uD55C.\"\n   
      },\n    {\n      \"id\": 14,\n      \"type\": \"Pause\",\n      \"duration\":
      0.8\n    },\n    {\n      \"id\": 15,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.0,\n      \"text\": \"\uBE57\uC18C\uB9AC \uC0AC\uC774\uB85C
      \uBC1C\uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4.\"\n    },\n    {\n      \"id\":
      16,\n      \"type\": \"Narration\",\n      \"duration\": 1.8,\n      \"text\":
      \"\uC800\uBC85. \uC800\uBC85.\"\n    },\n    {\n      \"id\": 17,\n      \"type\":
      \"Narration\",\n      \"duration\": 3.0,\n      \"text\": \"\uAE09\uD558\uC9C0
      \uC54A\uC558\uB2E4. \uB6F0\uC9C0 \uC54A\uC558\uB2E4.\\n\uBE57\uC18D\uC744 \uCC9C\uCC9C\uD788
      \uAC78\uC5B4\uC624\uB294 \uC18C\uB9AC\uC600\uB2E4.\"\n    },\n    {\n     
      \"id\": 18,\n      \"type\": \"Pause\",\n      \"duration\": 0.5\n    },\n   
      {\n      \"id\": 19,\n      \"type\": \"Narration\",\n      \"duration\": 2.0,\n     
      \"text\": \"\uD604\uC774\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 20,\n     
      \"type\": \"Narration\",\n      \"duration\": 4.2,\n      \"text\": \"\uAC80\uC740
      \uD6C4\uB4DC\uC5D0 \uB871\uCF54\uD2B8. \uBE68\uAC04 \uC6B0\uC0B0\uC744 \uB4E4\uACE0,\\n\uC190\uC744
      \uC8FC\uBA38\uB2C8\uC5D0 \uCC0C\uB978 \uCC44,\\n\uC870\uAE08\uB3C4 \uC11C\uB450\uB974\uC9C0
      \uC54A\uC73C\uBA70 \uAC78\uC5B4\uC624\uACE0 \uC788\uC5C8\uB2E4.\"\n    },\n   
      {\n      \"id\": 21,\n      \"type\": \"Narration\",\n      \"duration\": 3.5,\n     
      \"text\": \"\uB9C8\uCE58 \uBE44\uAC00 \uC624\uC9C0 \uC54A\uB294 \uB0A0\uCC98\uB7FC.\\n\uCC98\uC74C\uBD80\uD130
      \uC774\uB9AC\uB85C \uC624\uB824\uACE0 \uD588\uB358 \uC0AC\uB78C\uCC98\uB7FC.\"\n   
      },\n    {\n      \"id\": 22,\n      \"type\": \"Pause\",\n      \"duration\":
      0.8\n    },\n    {\n      \"id\": 23,\n      \"type\": \"Narration\",\n     
      \"duration\": 3.8,\n      \"text\": \"\uC5F0\uC11C \uC55E\uC5D0 \uBA48\uCDC4\uB2E4.\\n\uC6B0\uC0B0\uC774
      \uC5F0\uC11C \uC704\uB85C \uD3BC\uCCD0\uC84C\uB2E4.\\n\uBE57\uC18C\uB9AC\uAC00
      \uC870\uAE08 \uBA40\uC5B4\uC84C\uB2E4.\"\n    },\n    {\n      \"id\": 24,\n     
      \"type\": \"Pause\",\n      \"duration\": 0.8\n    },\n    {\n      \"id\":
      25,\n      \"type\": \"Dialogue\",\n      \"duration\": 2.2,\n      \"text\":
      \"\\\"\uC5EC\uAE30\uC11C \uBB50\uD574.\\\"\",\n      \"speaker\": \"\uD604\"\n   
      },\n    {\n      \"id\": 26,\n      \"type\": \"Dialogue\",\n      \"duration\":
      2.0,\n      \"text\": \"\\\"\uC9D1\uC5D0 \uAC00\uC790.\\\"\",\n      \"speaker\":
      \"\uD604\"\n    },\n    {\n      \"id\": 27,\n      \"type\": \"Pause\",\n     
      \"duration\": 0.6\n    },\n    {\n      \"id\": 28,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.8,\n      \"text\": \"\uC5F0\uC11C\uB294 \uB300\uB2F5\uD558\uC9C0
      \uC54A\uC558\uB2E4.\\n\uADF8\uB0E5 \uD604\uC758 \uC606\uC73C\uB85C \uAC78\uC5B4\uAC14\uB2E4.\"\n   
      },\n    {\n      \"id\": 29,\n      \"type\": \"Pause\",\n      \"duration\":
      0.6\n    },\n    {\n      \"id\": 30,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.0,\n      \"text\": \"\uACE8\uBAA9\uC744 \uAEBE\uC5C8\uC744
      \uB54C\uC600\uB2E4.\"\n    },\n    {\n      \"id\": 31,\n      \"type\": \"Narration\",\n     
      \"duration\": 3.0,\n      \"text\": \"\uC5F0\uC11C\uC758 \uC190\uC774 \uC6B0\uC0B0
      \uC0B4\uC744 \uC7A1\uC558\uB2E4.\\n\uCC9C\uCC9C\uD788, \uD604 \uCABD\uC73C\uB85C
      \uBC00\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 32,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.8,\n      \"text\": \"\uD604\uC774 \uAC78\uC74C\uC744 \uBA48\uCDC4\uB2E4.\\n\uC6B0\uC0B0\uC774
      \uC790\uAE30 \uCABD\uC73C\uB85C \uAE30\uC6B8\uC5B4\uC838 \uC788\uC5C8\uB2E4.\"\n   
      },\n    {\n      \"id\": 33,\n      \"type\": \"Pause\",\n      \"duration\":
      0.6\n    },\n    {\n      \"id\": 34,\n      \"type\": \"Dialogue\",\n     
      \"duration\": 2.5,\n      \"text\": \"\\\"\u2026\uBC18\uB9CC\uC694.\\\"\",\n     
      \"speaker\": \"\uC5F0\uC11C\"\n    },\n    {\n      \"id\": 35,\n      \"type\":
      \"Pause\",\n      \"duration\": 1.0\n    },\n    {\n      \"id\": 36,\n     
      \"type\": \"Narration\",\n      \"duration\": 4.0,\n      \"text\": \"\uD604\uC740
      \uC7A0\uAE50 \uC5F0\uC11C\uB97C \uBD24\uB2E4.\\n\uC5F4 \uC0B4\uC9DC\uB9AC \uC544\uC774.
      \uAD73\uC5B4\uC788\uB294 \uC5BC\uAD74.\\n\uADF8\uB7EC\uB098 \uC190\uC740 \uC6B0\uC0B0\uC744
      \uD604 \uCABD\uC73C\uB85C \uBC00\uACE0 \uC788\uB294 \uC544\uC774.\"\n    },\n   
      {\n      \"id\": 37,\n      \"type\": \"Pause\",\n      \"duration\": 0.5\n   
      },\n    {\n      \"id\": 38,\n      \"type\": \"Narration\",\n      \"duration\":
      4.5,\n      \"text\": \"\uC544\uBB34 \uB9D0 \uD558\uC9C0 \uC54A\uC558\uB2E4.\\n\uADF8\uB0E5
      \uAC78\uC5C8\uB2E4. \uC6B0\uC0B0\uC744 \uAC00\uC6B4\uB370\uB85C \uC62E\uACA8
      \uC7A1\uC73C\uBA70.\\n\uB458\uC774 \uB098\uB780\uD788, \uBC18\uC529 \uBE44\uB97C
      \uB9DE\uC73C\uBA70, \uACE8\uBAA9\uC744 \uAC78\uC5C8\uB2E4.\"\n    },\n    {\n     
      \"id\": 39,\n      \"type\": \"Pause\",\n      \"duration\": 0.8\n    },\n   
      {\n      \"id\": 40,\n      \"type\": \"FadeOut\",\n      \"duration\": 0.9\n   
      },\n    {\n      \"id\": 41,\n      \"type\": \"FadeIn\",\n      \"duration\":
      0.9\n    },\n    {\n      \"id\": 42,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.0,\n      \"text\": \"\uBD84\uC2DD\uC9D1\uC740 \uACE8\uBAA9
      \uB05D\uC5D0 \uC788\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 43,\n     
      \"type\": \"Narration\",\n      \"duration\": 1.5,\n      \"text\": \"\uAF2C\uB974\uB975.\"\n   
      },\n    {\n      \"id\": 44,\n      \"type\": \"Narration\",\n      \"duration\":
      3.5,\n      \"text\": \"\uC18C\uB9AC\uAC00 \uB0AC\uB2E4. \uC5F0\uC11C\uAC00
      \uAD73\uC5C8\uB2E4. \uD604\uC740 \uC5F0\uC11C\uB97C \uBCF4\uC9C0 \uC54A\uC558\uB2E4.\\n\uADF8\uB0E5
      \uBD84\uC2DD\uC9D1 \uBB38\uC744 \uC7A1\uC544\uB2F9\uACBC\uB2E4.\"\n    },\n   
      {\n      \"id\": 45,\n      \"type\": \"Dialogue\",\n      \"duration\": 2.0,\n     
      \"text\": \"\\\"\uB4E4\uC5B4\uC640.\\\"\",\n      \"speaker\": \"\uD604\"\n   
      },\n    {\n      \"id\": 46,\n      \"type\": \"Narration\",\n      \"duration\":
      3.2,\n      \"text\": \"\uB0A1\uC740 \uB098\uBB34 \uC758\uC790. \uBE68\uAC04
      \uD50C\uB77C\uC2A4\uD2F1 \uC7C1\uBC18.\\n\uB5A1\uBCF6\uC774 \uD55C \uC811\uC2DC\uAC00
      \uB098\uC654\uB2E4. \uB458\uC774 \uB098\uB780\uD788 \uC549\uC558\uB2E4.\"\n   
      },\n    {\n      \"id\": 47,\n      \"type\": \"Dialogue\",\n      \"duration\":
      2.0,\n      \"text\": \"\\\"\uB9CE\uC774 \uBA39\uC5B4.\\\"\",\n      \"speaker\":
      \"\uD604\"\n    },\n    {\n      \"id\": 48,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.0,\n      \"text\": \"\uADF8\uAC8C \uC804\uBD80\uC600\uB2E4.\"\n   
      },\n    {\n      \"id\": 49,\n      \"type\": \"Pause\",\n      \"duration\":
      0.8\n    },\n    {\n      \"id\": 50,\n      \"type\": \"Narration\",\n     
      \"duration\": 3.8,\n      \"text\": \"\uC5F0\uC11C\uB294 \uCC3D\uBB38 \uBC16\uC744
      \uBD24\uB2E4. \uBE44\uAC00 \uACC4\uC18D \uB0B4\uB9AC\uACE0 \uC788\uC5C8\uB2E4.\\n\uC7A0\uAE50.
      \uADF8\uB0E5, \uBCF4\uD1B5\uC758 \uC5F4 \uC0B4\uC9DC\uB9AC \uC544\uC774\uC758
      \uB208\uC774\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 51,\n      \"type\":
      \"Pause\",\n      \"duration\": 0.8\n    },\n    {\n      \"id\": 52,\n     
      \"type\": \"FadeOut\",\n      \"duration\": 0.9\n    },\n    {\n      \"id\":
      53,\n      \"type\": \"FadeIn\",\n      \"duration\": 0.9\n    },\n    {\n     
      \"id\": 54,\n      \"type\": \"Narration\",\n      \"duration\": 3.2,\n     
      \"text\": \"\uBD84\uC2DD\uC9D1\uC744 \uB098\uC624\uB2C8 \uBC14\uB78C\uC774
      \uC300\uC300\uD588\uB2E4.\\n\uAC00\uC744\uBE44\uC600\uB2E4. \uACE7 \uACA8\uC6B8\uC774
      \uC62C \uAC83\uC774\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 55,\n     
      \"type\": \"Narration\",\n      \"duration\": 3.5,\n      \"text\": \"\uD604\uC774
      \uAC78\uC74C\uC744 \uBA48\uCDC4\uB2E4.\\n\uC9C4\uC5F4\uB300\uC5D0 \uBAA9\uB3C4\uB9AC
      \uBA87 \uAC1C\uAC00 \uAC78\uB824\uC788\uC5C8\uB2E4.\\n\uC544\uBB34 \uB9D0 \uC5C6\uC774
      \uAC00\uAC8C \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC14\uB2E4.\"\n    },\n    {\n     
      \"id\": 56,\n      \"type\": \"Narration\",\n      \"duration\": 3.0,\n     
      \"text\": \"1\uBD84\uB3C4 \uC548 \uAC78\uB838\uB2E4.\\n\uB098\uC62C \uB54C
      \uC190\uC5D0 \uBE68\uAC04 \uBAA9\uB3C4\uB9AC\uAC00 \uB4E4\uB824\uC788\uC5C8\uB2E4.\"\n   
      },\n    {\n      \"id\": 57,\n      \"type\": \"Dialogue\",\n      \"duration\":
      2.0,\n      \"text\": \"\\\"\uD558\uACE0 \uB2E4\uB140.\\\"\",\n      \"speaker\":
      \"\uD604\"\n    },\n    {\n      \"id\": 58,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.5,\n      \"text\": \"\uC5F0\uC11C\uAC00 \uBC1B\uC558\uB2E4.
      \uBE68\uAC04\uC0C9\uC774\uC5C8\uB2E4.\\n\uBAA9\uC5D0 \uB458\uB800\uB2E4.\"\n   
      },\n    {\n      \"id\": 59,\n      \"type\": \"Dialogue\",\n      \"duration\":
      2.2,\n      \"text\": \"\\\"\u2026\uACE0\uB9C8\uC6CC\uC694.\\\"\",\n      \"speaker\":
      \"\uC5F0\uC11C\"\n    },\n    {\n      \"id\": 60,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.0,\n      \"text\": \"\uD604\uC740 \uC774\uBBF8 \uAC77\uACE0
      \uC788\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\": 61,\n      \"type\": \"Pause\",\n     
      \"duration\": 0.8\n    },\n    {\n      \"id\": 62,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.2,\n      \"text\": \"\uC778\uC0DD\uB124\uCEF7 \uBD80\uC2A4\uB294
      \uACE8\uBAA9 \uC5B4\uADC0\uC5D0 \uC788\uC5C8\uB2E4.\"\n    },\n    {\n     
      \"id\": 63,\n      \"type\": \"Narration\",\n      \"duration\": 1.5,\n     
      \"text\": \"\uC5F0\uC11C\uAC00 \uBA48\uCDC4\uB2E4.\"\n    },\n    {\n     
      \"id\": 64,\n      \"type\": \"Dialogue\",\n      \"duration\": 1.8,\n     
      \"text\": \"\\\"\u2026\uC624\uBE60.\\\"\",\n      \"speaker\": \"\uC5F0\uC11C\"\n   
      },\n    {\n      \"id\": 65,\n      \"type\": \"Narration\",\n      \"duration\":
      2.8,\n      \"text\": \"\uB9D0\uC744 \uC787\uC9C0 \uC54A\uC558\uB2E4.\\n\uBD80\uC2A4\uB97C
      \uBCF4\uB2E4\uAC00 \uB2E4\uC2DC \uC2E0\uBC1C \uB05D\uC744 \uBD24\uB2E4.\"\n   
      },\n    {\n      \"id\": 66,\n      \"type\": \"Dialogue\",\n      \"duration\":
      1.8,\n      \"text\": \"\\\"\uC544\uB2C8\uC5D0\uC694.\\\"\",\n      \"speaker\":
      \"\uC5F0\uC11C\"\n    },\n    {\n      \"id\": 67,\n      \"type\": \"Dialogue\",\n     
      \"duration\": 2.0,\n      \"text\": \"\\\"\uCC0D\uC744 \uAC70\uC57C?\\\"\",\n     
      \"speaker\": \"\uD604\"\n    },\n    {\n      \"id\": 68,\n      \"type\":
      \"Narration\",\n      \"duration\": 2.5,\n      \"text\": \"\uC5F0\uC11C\uAC00
      \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uC544\uC8FC \uC870\uAE08. \uACA8\uC6B0.\"\n   
      },\n    {\n      \"id\": 69,\n      \"type\": \"Pause\",\n      \"duration\":
      0.5\n    },\n    {\n      \"id\": 70,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.8,\n      \"text\": \"\uC881\uC740 \uBD80\uC2A4 \uC548\uC5D0
      \uB458\uC774 \uB4E4\uC5B4\uAC14\uB2E4.\\n\uCE74\uC6B4\uD2B8\uB2E4\uC6B4\uC774
      \uC2DC\uC791\uB410\uB2E4.\"\n    },\n    {\n      \"id\": 71,\n      \"type\":
      \"Narration\",\n      \"duration\": 1.5,\n      \"text\": \"\uCC30\uCE75.\"\n   
      },\n    {\n      \"id\": 72,\n      \"type\": \"Pause\",\n      \"duration\":
      0.5\n    },\n    {\n      \"id\": 73,\n      \"type\": \"Narration\",\n     
      \"duration\": 2.5,\n      \"text\": \"\uB458 \uB2E4 \uAD73\uC5B4\uC788\uC5C8\uB2E4.
      \uC5B4\uC0C9\uD558\uACE0 \uBD88\uADE0\uD615\uD55C \uC0AC\uC9C4\uC774\uC5C8\uB2E4.\"\n   
      },\n    {\n      \"id\": 74,\n      \"type\": \"Narration\",\n      \"duration\":
      1.8,\n      \"text\": \"\uC5F0\uC11C\uAC00 \uC0AC\uC9C4\uC744 \uBD24\uB2E4.\"\n   
      },\n    {\n      \"id\": 75,\n      \"type\": \"Narration\",\n      \"duration\":
      2.0,\n      \"text\": \"\uC6C3\uC5C8\uB2E4.\"\n    },\n    {\n      \"id\":
      76,\n      \"type\": \"Narration\",\n      \"duration\": 3.8,\n      \"text\":
      \"\uC18C\uB9AC \uC5C6\uC774, \uC544\uC8FC \uC7A0\uAE50, \uC785\uAF2C\uB9AC\uAC00
      \uC62C\uB77C\uAC14\uB2E4.\\n\uADF8\uAC8C \uC804\uBD80\uC600\uC9C0\uB9CC, \uADF8\uAC8C
      \uC804\uBD80\uC774\uAE30\uC5D0 \uCDA9\uBD84\uD588\uB2E4.\"\n    },\n    {\n     
      \"id\": 77,\n      \"type\": \"Pause\",\n      \"duration\": 0.8\n    },\n   
      {\n      \"id\": 78,\n      \"type\": \"Dialogue\",\n      \"duration\": 2.2,\n     
      \"text\": \"\\\"\u2026\uD55C \uC7A5 \uAC00\uC838\uB3C4 \uB3FC\uC694?\\\"\",\n     
      \"speaker\": \"\uC5F0\uC11C\"\n    },\n    {\n      \"id\": 79,\n      \"type\":
      \"Dialogue\",\n      \"duration\": 1.5,\n      \"text\": \"\\\"\uADF8\uB798.\\\"\",\n     
      \"speaker\": \"\uD604\"\n    },\n    {\n      \"id\": 80,\n      \"type\":
      \"Narration\",\n      \"duration\": 4.0,\n      \"text\": \"\uC5F0\uC11C\uAC00
      \uC0AC\uC9C4\uC744 \uBC18\uC73C\uB85C \uC798\uB790\uB2E4.\\n\uD55C \uC7A5\uC744
      \uAC00\uC84C\uB2E4. \uD55C \uC7A5\uC744 \uD604\uC5D0\uAC8C \uB0B4\uBC00\uC5C8\uB2E4.\\n\uD604\uC774
      \uBC1B\uC558\uB2E4. \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4.\"\n    },\n   
      {\n      \"id\": 81,\n      \"type\": \"Pause\",\n      \"duration\": 0.8\n   
